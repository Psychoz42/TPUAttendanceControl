<?xml version="1.0" encoding="utf-8"?>
<!--
    Сетевая политика приложения.
    Весь незашифрованный HTTP-трафик запрещён, доверяем только
    системным сертификатам (пользовательские CA не принимаются).
    Для debug-сборки HTTP разрешён в src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
