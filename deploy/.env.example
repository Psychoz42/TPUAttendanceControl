# Скопировать в deploy/.env и заполнить. Этот файл читает docker compose
# домен с A-записью на этот сервер: на него Caddy получит HTTPS-сертификат
DOMAIN=attendance.example.com
# папка с веткой frontend относительно deploy/
FRONTEND_PATH=../../TPUAttendanceControlFrontend
# обе строки сгенерировать через: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
# через сколько дней удалять занятия и списки отметившихся, 0 значит хранить бессрочно
EVENT_RETENTION_DAYS=0
